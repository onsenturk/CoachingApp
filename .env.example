# ───────────────────────────────────────────────────────────────────
# CoachingApp environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ───────────────────────────────────────────────────────────────────

# Node / Next.js
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-32+-bytes-base64

# Postgres (matches docker-compose service `postgres`)
POSTGRES_USER=coaching
POSTGRES_PASSWORD=coaching
POSTGRES_DB=coaching
DATABASE_URL=postgresql://coaching:coaching@localhost:5433/coaching?schema=public

# Redis (matches docker-compose service `redis`)
REDIS_URL=redis://localhost:6379

# Strava OAuth — register an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-me-random-string

# Token encryption key (libsodium secretbox key, 32 bytes base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Azure AI Foundry (see azure.md)
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_MODEL=gpt-5-4
AZURE_FOUNDRY_AGENT_PREFIX=coaching
# Auth via DefaultAzureCredential (az login locally; managed identity in cloud)

# Optional: email notifications via Resend (https://resend.com)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
