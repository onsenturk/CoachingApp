{
  "name": "coaching-app",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @coaching/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @coaching/db db:generate",
    "db:migrate": "pnpm --filter @coaching/db db:migrate",
    "db:studio": "pnpm --filter @coaching/db db:studio",
    "worker": "pnpm --filter @coaching/worker dev",
    "agents:sync": "pwsh ./scripts/sync-foundry-agents.ps1"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "eslint": "9.39.4",
    "prettier": "3.9.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vitest": "4.1.9"
  }
}
